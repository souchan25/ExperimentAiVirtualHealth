# --- General Gitignore ---
# Ignore sensitive and unnecessary files for Git/GitHub

# Dependencies
node_modules/
venv/
env/
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Database
*.sqlite3
*.db
*.sql
*.mysql

# Expo / React Native
.expo/
dist/
web-build/
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
expo-env.d.ts
/ios
/android

# Native Binaries & Keys
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.cer
*.crt
*.pfx

# Frontend (Vite/Next/etc)
dist/
.next/
out/
.vercel
.eslintcache
*.tsbuildinfo

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs / Editors
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Logs and Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
error_log.txt

Mobile/
